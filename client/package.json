{
  "name": "ubiquitous-client",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/ui/**/*.{ts,tsx,css}\" \"src/gameplay/TouchJoystick.ts\" \"dev/hud-lab.tsx\" \"dev/front.tsx\" \"test/ui/**/*.{ts,tsx}\" \"test/helpers/themeTokens.ts\"",
    "format:check": "prettier --check \"src/ui/**/*.{ts,tsx,css}\" \"src/gameplay/TouchJoystick.ts\" \"dev/hud-lab.tsx\" \"dev/front.tsx\" \"test/ui/**/*.{ts,tsx}\" \"test/helpers/themeTokens.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.dev.json",
    "typecheck:dev": "tsc --noEmit -p tsconfig.dev.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "measure:bundle": "npm run build && node dev/bundleMetrics.mjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/preact": "3.2.4",
    "@types/node": "26.4.0",
    "@types/three": "0.185.4",
    "happy-dom": "20.11.2",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "5.3.0",
    "@preact/signals": "2.11.1",
    "preact": "10.29.8",
    "three": "0.185.1"
  }
}
